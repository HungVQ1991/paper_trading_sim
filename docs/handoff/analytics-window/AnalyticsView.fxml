<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="18" styleClass="dialog-shell" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trading.sim.ui.AnalyticsController">
  <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
  <Label styleClass="dialog-title" text="Performance Analytics" />
  <HBox spacing="12">
    <VBox spacing="6" styleClass="summary-card" HBox.hgrow="ALWAYS">
      <Label styleClass="summary-label" text="WIN RATE" />
      <Label fx:id="winRateLabel" styleClass="summary-value" />
    </VBox>
    <VBox spacing="6" styleClass="summary-card" HBox.hgrow="ALWAYS">
      <Label styleClass="summary-label" text="NET REALIZED P&amp;L" />
      <Label fx:id="realizedPnLLabel" styleClass="summary-value" />
    </VBox>
    <VBox spacing="6" styleClass="summary-card" HBox.hgrow="ALWAYS">
      <Label styleClass="summary-label" text="TOTAL TRADES" />
      <Label fx:id="tradeCountLabel" styleClass="summary-value" />
    </VBox>
    <VBox spacing="6" styleClass="summary-card" HBox.hgrow="ALWAYS">
      <Label styleClass="summary-label" text="MAX DRAWDOWN" />
      <Label fx:id="maxDrawdownLabel" styleClass="summary-value" />
    </VBox>
  </HBox>
  <StackPane styleClass="panel" VBox.vgrow="ALWAYS">
    <LineChart fx:id="equityChart" animated="false" createSymbols="false"
               legendVisible="false" title="Equity Curve">
      <xAxis>
        <NumberAxis forceZeroInRange="false" label="Fill number (0 = starting cash)"
                    minorTickVisible="false" />
      </xAxis>
      <yAxis>
        <NumberAxis forceZeroInRange="false" label="Equity ($)" />
      </yAxis>
    </LineChart>
    <Label fx:id="emptyStateLabel" styleClass="dialog-subtitle"
           text="No fills yet. The equity curve appears after your first trade." />
  </StackPane>
  <HBox alignment="CENTER_RIGHT">
    <Button fx:id="btnExportCsv" onAction="#exportCsv" text="Export CSV" />
  </HBox>
</VBox>
