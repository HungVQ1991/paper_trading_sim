<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="460.0" prefWidth="430.0" spacing="14" styleClass="dialog-shell"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trading.sim.ui.OrderDialogController">
  <fx:define>
    <ToggleGroup fx:id="sideToggleGroup" />
  </fx:define>
  <padding>
    <Insets bottom="20" left="20" right="20" top="20" />
  </padding>
  <Label styleClass="dialog-title" text="Place New Order" />
  <Label styleClass="dialog-subtitle" text="Preview an order before connecting the trading engine." />
  <Separator />
  <GridPane hgap="12" vgap="12">
    <columnConstraints>
      <ColumnConstraints halignment="RIGHT" minWidth="105.0" />
      <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>
    <Label text="Symbol" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <ComboBox fx:id="symbolComboBox" maxWidth="1.7976931348623157E308"
              GridPane.columnIndex="1" GridPane.rowIndex="0" />
    <Label text="Side" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <HBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="1">
      <RadioButton fx:id="buyRadio" selected="true" text="Buy" toggleGroup="$sideToggleGroup" />
      <RadioButton text="Sell" toggleGroup="$sideToggleGroup" />
    </HBox>
    <Label text="Order Type" GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <ComboBox fx:id="orderTypeComboBox" maxWidth="1.7976931348623157E308"
              onAction="#updateOrderType" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <Label text="Quantity" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <TextField fx:id="quantityField" promptText="Whole shares" GridPane.columnIndex="1"
               GridPane.rowIndex="3" />
    <Label text="Limit Price" GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <TextField fx:id="limitPriceField" promptText="Only for limit orders" GridPane.columnIndex="1"
               GridPane.rowIndex="4" />
  </GridPane>
  <VBox spacing="6" styleClass="estimate-panel">
    <Label fx:id="estimatedCostLabel" styleClass="estimate-value" text="Estimated cost: \$0.00" />
    <Label fx:id="validationMessageLabel" styleClass="validation-message" wrapText="true" />
  </VBox>
  <HBox alignment="CENTER_RIGHT" spacing="10">
    <Button onAction="#closeDialog" text="Cancel" />
    <Button onAction="#confirmOrder" styleClass="buy-button" text="Preview Order" />
  </HBox>
</VBox>
