<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.trading.ui.SettingsController"
      spacing="16.0"
      stylesheets="@../css/dark-theme.css"
      style="-fx-background-color: #131722; -fx-padding: 20;">

  <children>
    <Label text="CÀI ĐẶT NGUỒN DỮ LIỆU &amp; HỆ THỐNG"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2962ff;" />

    <Separator />

    <GridPane hgap="12.0" vgap="14.0">
      <children>
        <Label text="Nguồn cấp dữ liệu:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-text-fill: #d1d4dc; -fx-font-weight: bold;" />
        <ComboBox fx:id="cmbProvider" prefWidth="260.0"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Twelve Data API Key:" GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-text-fill: #d1d4dc;" />
        <TextField fx:id="txtTwelveDataKey" promptText="Nhập khóa API Twelve Data"
                   prefWidth="260.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Finnhub API Key:" GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-text-fill: #d1d4dc;" />
        <TextField fx:id="txtFinnhubKey" promptText="Nhập khóa API Finnhub"
                   prefWidth="260.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      </children>
    </GridPane>

    <Label fx:id="lblStatus" text="Trạng thái: Sẵn sàng"
           style="-fx-text-fill: #26a69a; -fx-font-size: 12px;" />

    <Separator />

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
      <children>
        <Button fx:id="btnResetAccount" text="Đặt lại tài khoản ($100k)"
                onAction="#handleResetAccount" styleClass="btn-sell" />
        <Button fx:id="btnApply" text="Áp dụng &amp; Chuyển đổi"
                onAction="#handleApply" styleClass="btn-action" />
      </children>
    </HBox>
  </children>
</VBox>
